MODE=PAPER
DATABASE_PATH=paper_trading.sqlite3
LOG_LEVEL=INFO
RETENTION_DAYS=14

# Public market-data endpoints only. No keys or wallet credentials are used.
BINANCE_SYMBOL=BTCUSDT
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/btcusdt@bookTicker
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Current documented crypto taker-rate fallback; market metadata wins when present.
POLYMARKET_TAKER_FEE_RATE=0.07
POLYMARKET_FEE_EXPONENT=1
POLYMARKET_FEES_ENABLED=true
NETWORK_TIMEOUT_SECONDS=10
# Keep true in normal use. Set false only for a controlled environment with a
# broken intercepting CA; this disables TLS certificate verification.
HTTP_VERIFY=true
MARKET_POLL_SECONDS=15
BOOK_REFRESH_SECONDS=5

# Risk limits.
STARTING_CAPITAL=1000
MAX_CAPITAL_PER_TRADE=25
MAX_SIMULTANEOUS_EXPOSURE=100
MAX_DAILY_LOSS=50
MAX_CONSECUTIVE_LOSSES=5
MINIMUM_NET_EDGE=0.01
MINIMUM_LIQUIDITY=5
MAXIMUM_DATA_AGE_MS=2000
MAXIMUM_EXECUTION_LATENCY_MS=1500
FAILED_ORDERS_BEFORE_BREAKER=3

# Explicit research parameters.
VOLATILITY_LOOKBACK=60
MINIMUM_VOLATILITY_OBSERVATIONS=5
VOLATILITY_FALLBACK_ANNUALIZED=0
EXECUTION_BUFFER=0.005
SIZING_CAPITAL=25
MAX_TIME_REMAINING_FOR_LATE_MARKET_S=90
